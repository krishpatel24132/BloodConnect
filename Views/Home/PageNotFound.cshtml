@{
    ViewData["Title"] = "Page not found";
    int code = ViewBag.Code is int c ? c : 404;
}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-danger">@code</div>
    <h1 class="h3">@(code == 404 ? "Page not found" : "Something went wrong")</h1>
    <p class="text-body-secondary">The page you are looking for does not exist or has been moved.</p>
    <a class="btn btn-bc" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Back to Dashboard</a>
</div>
