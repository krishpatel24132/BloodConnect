@model Donor
@{
    ViewData["Title"] = Model.FullName;
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.FullName <span class="blood-chip ms-2">@Model.BloodGroup</span></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        @if (isAdmin)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-bc" asp-controller="Donations" asp-action="Create" asp-route-donorId="@Model.Id">Record Donation</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Profile</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Email</dt><dd class="col-7 text-break">@Model.Email</dd>
                    <dt class="col-5">Mobile</dt><dd class="col-7">@Model.Phone</dd>
                    <dt class="col-5">Age</dt><dd class="col-7">@Model.Age years</dd>
                    <dt class="col-5">City</dt><dd class="col-7">@Model.City</dd>
                    <dt class="col-5">Last donated</dt>
                    <dd class="col-7">@(Model.LastDonationDate?.ToString("dd MMM yyyy") ?? "Never")</dd>
                    <dt class="col-5">Eligibility</dt>
                    <dd class="col-7">
                        @if (Model.IsEligible) { <span class="badge text-bg-success">Eligible to donate</span> }
                        else if (!Model.IsAvailable) { <span class="badge text-bg-secondary">Marked unavailable</span> }
                        else { <span class="badge text-bg-warning">Waiting period (90 days)</span> }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Donation History</div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Units</th><th>For request</th></tr></thead>
                    <tbody>
                        @if (!Model.Donations.Any())
                        {
                            <tr><td colspan="3" class="text-center text-body-secondary py-3">No donations recorded yet.</td></tr>
                        }
                        @foreach (var x in Model.Donations.OrderByDescending(x => x.DonatedOn))
                        {
                            <tr>
                                <td>@(x.DonatedOn?.ToString("dd MMM yyyy"))</td>
                                <td>@x.Units</td>
                                <td>
                                    @if (x.BloodRequest != null)
                                    {
                                        <a asp-controller="Requests" asp-action="Details" asp-route-id="@x.BloodRequestId">@x.BloodRequest.PatientName</a>
                                    }
                                    else { <span class="text-body-secondary">General donation</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
