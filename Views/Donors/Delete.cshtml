@model Donor
@{
    ViewData["Title"] = "Delete Donor";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h1 class="h4 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete this donor?</h1>
                <p class="text-body-secondary">This also removes the donor's donation history and cannot be undone.</p>
                <dl class="row">
                    <dt class="col-4">Name</dt><dd class="col-8">@Model.FullName</dd>
                    <dt class="col-4">Blood group</dt><dd class="col-8">@Model.BloodGroup</dd>
                    <dt class="col-4">City</dt><dd class="col-8">@Model.City</dd>
                    <dt class="col-4">Email</dt><dd class="col-8 text-break">@Model.Email</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Yes, delete</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
