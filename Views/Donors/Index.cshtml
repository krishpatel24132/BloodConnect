@model List<Donor>
@{
    ViewData["Title"] = "Donors";
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    string sort = ViewBag.Sort as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-people-fill text-danger"></i> Donors <small class="text-body-secondary fs-6">(@ViewBag.Total)</small></h1>
    <div class="d-flex flex-wrap gap-2">
        @if (isAdmin)
        {
            <form asp-action="AddSamples" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-magic"></i> Add example donors</button>
            </form>
            <a class="btn btn-outline-secondary" asp-action="ExportCsv"><i class="bi bi-download"></i> Export CSV</a>
        }
        @* Visible to everyone; if not logged in as admin, Create sends you to the login page and then back to the form *@
        <a class="btn btn-bc" asp-action="Create"><i class="bi bi-person-plus"></i> Add Donor</a>
    </div>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <input type="hidden" name="sort" value="@sort" />
    <div class="col-12 col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or city" />
    </div>
    <div class="col-8 col-md-3">
        <select name="bloodGroup" class="form-select" asp-items="@(new SelectList(Lookups.BloodGroups, (string)ViewBag.BloodGroup))">
            <option value="">All blood groups</option>
        </select>
    </div>
    <div class="col-4 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-bc"><i class="bi bi-search"></i> Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="true">Clear</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-sort="name">Name <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-sort="group">Group <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-sort="city">City <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th class="d-none d-md-table-cell">Mobile</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-body-secondary py-4">
                            <div>No donors found.</div>
                            <div class="mt-3 d-flex flex-wrap justify-content-center gap-2">
                                <a class="btn btn-bc btn-sm" asp-action="Create"><i class="bi bi-person-plus"></i> Add Donor</a>
                                @if (isAdmin)
                                {
                                    <form asp-action="AddSamples" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-magic"></i> Add example donors</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@d.Id" class="fw-semibold text-decoration-none">@d.FullName</a></td>
                        <td><span class="blood-chip">@d.BloodGroup</span></td>
                        <td>@d.City</td>
                        <td class="d-none d-md-table-cell"><a href="tel:@d.Phone" class="text-decoration-none"><i class="bi bi-telephone"></i> @d.Phone</a></td>
                        <td>
                            @if (d.IsEligible) { <span class="badge text-bg-success">Eligible</span> }
                            else if (!d.IsAvailable) { <span class="badge text-bg-secondary">Unavailable</span> }
                            else { <span class="badge text-bg-warning">Recently donated</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.Id" title="Details"><i class="bi bi-eye"></i></a>
                            @if (isAdmin)
                            {
                                <form asp-action="ToggleAvailability" asp-route-id="@d.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Switch availability"><i class="bi @(d.IsAvailable ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                                </form>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Donor pages">
        <ul class="pagination justify-content-center flex-wrap">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-sort="@sort">@p</a>
                </li>
            }
        </ul>
    </nav>
}
