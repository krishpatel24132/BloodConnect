@model BloodRequest
@{
    ViewData["Title"] = "Edit Blood Request";
}

<h1 class="h3 mb-3"><i class="bi bi-pencil-square text-danger"></i> Edit Blood Request</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-bc">Update Request</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
