@model List<BloodRequest>
@{
    ViewData["Title"] = "Blood Requests";
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-hospital text-danger"></i> Blood Requests <small class="text-body-secondary fs-6">(@ViewBag.Total)</small></h1>
    <a class="btn btn-bc" asp-action="Create"><i class="bi bi-plus-circle"></i> New Request</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <select name="status" class="form-select" asp-items="@(new SelectList(Lookups.RequestStatuses, (string)ViewBag.Status))">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select name="urgency" class="form-select" asp-items="@(new SelectList(Lookups.UrgencyLevels, (string)ViewBag.Urgency))">
            <option value="">All urgency levels</option>
        </select>
    </div>
    <div class="col-12 col-md-6 d-flex gap-2">
        <button type="submit" class="btn btn-bc"><i class="bi bi-funnel"></i> Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Patient</th>
                    <th>Group</th>
                    <th class="d-none d-md-table-cell">Hospital</th>
                    <th>Units</th>
                    <th class="d-none d-md-table-cell">Needed by</th>
                    <th>Urgency</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-body-secondary py-4">No requests found.</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@r.Id" class="fw-semibold text-decoration-none">@r.PatientName</a></td>
                        <td><span class="blood-chip">@r.BloodGroup</span></td>
                        <td class="d-none d-md-table-cell">@r.Hospital, @r.City</td>
                        <td>@r.UnitsDonated / @r.Units</td>
                        <td class="d-none d-md-table-cell">@(r.RequiredBy?.ToString("dd MMM yyyy"))</td>
                        <td><span class="badge text-bg-@Lookups.UrgencyBadge(r.Urgency)">@r.Urgency</span></td>
                        <td><span class="badge text-bg-@Lookups.StatusBadge(r.Status)">@r.Status</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@r.Id" title="Details"><i class="bi bi-eye"></i></a>
                            @if (isAdmin)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Request pages">
        <ul class="pagination justify-content-center flex-wrap">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@ViewBag.Status" asp-route-urgency="@ViewBag.Urgency">@p</a>
                </li>
            }
        </ul>
    </nav>
}
