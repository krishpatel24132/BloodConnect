@model RequestDetailsViewModel
@{
    var r = Model.Request;
    ViewData["Title"] = "Request #" + r.Id;
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
    var pct = r.Units == 0 ? 0 : Math.Min(100, (int)Math.Round(r.UnitsDonated * 100.0 / r.Units));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">
        @r.PatientName <span class="blood-chip ms-2">@r.BloodGroup</span>
        <span class="badge text-bg-@Lookups.StatusBadge(r.Status) fs-6 ms-1">@r.Status</span>
    </h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        @if (isAdmin)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
            @if (r.Status == "Open")
            {
                <form asp-action="UpdateStatus" asp-route-id="@r.Id" method="post" class="m-0">
                    <input type="hidden" name="status" value="Cancelled" />
                    <button type="submit" class="btn btn-outline-secondary">Cancel Request</button>
                </form>
                <form asp-action="UpdateStatus" asp-route-id="@r.Id" method="post" class="m-0">
                    <input type="hidden" name="status" value="Fulfilled" />
                    <button type="submit" class="btn btn-success">Mark Fulfilled</button>
                </form>
            }
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Request Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Hospital</dt><dd class="col-7">@r.Hospital</dd>
                    <dt class="col-5">City</dt><dd class="col-7">@r.City</dd>
                    <dt class="col-5">Contact</dt><dd class="col-7">@r.ContactPhone</dd>
                    <dt class="col-5">Needed by</dt><dd class="col-7">@(r.RequiredBy?.ToString("dd MMM yyyy"))</dd>
                    <dt class="col-5">Urgency</dt><dd class="col-7"><span class="badge text-bg-@Lookups.UrgencyBadge(r.Urgency)">@r.Urgency</span></dd>
                    <dt class="col-5">Notes</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(r.Notes) ? "-" : r.Notes)</dd>
                </dl>
                <hr />
                <div class="d-flex justify-content-between small mb-1">
                    <span>Units collected</span><span>@r.UnitsDonated / @r.Units</span>
                </div>
                <div class="group-bar"><span style="width:@(pct)%"></span></div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Donations for this request</div>
            <ul class="list-group list-group-flush">
                @if (!r.Donations.Any())
                {
                    <li class="list-group-item text-body-secondary">No donations yet.</li>
                }
                @foreach (var d in r.Donations.OrderByDescending(x => x.DonatedOn))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <a asp-controller="Donors" asp-action="Details" asp-route-id="@d.DonorId">@d.Donor.FullName</a>
                        <span class="text-body-secondary">@d.Units unit(s) &middot; @(d.DonatedOn?.ToString("dd MMM"))</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Matching Eligible Donors <small class="text-body-secondary">(compatible group, available, 90-day gap passed; same city first)</small></div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Donor</th><th>Group</th><th>City</th><th>Mobile</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.MatchingDonors.Any())
                        {
                            <tr><td colspan="5" class="text-center text-body-secondary py-3">No eligible donors found for this group.</td></tr>
                        }
                        @foreach (var d in Model.MatchingDonors)
                        {
                            <tr>
                                <td><a asp-controller="Donors" asp-action="Details" asp-route-id="@d.Id" class="text-decoration-none">@d.FullName</a></td>
                                <td><span class="blood-chip">@d.BloodGroup</span></td>
                                <td>@d.City</td>
                                <td>@d.Phone</td>
                                <td class="text-end">
                                    @if (isAdmin && r.Status == "Open")
                                    {
                                        <a class="btn btn-sm btn-bc" asp-controller="Donations" asp-action="Create" asp-route-donorId="@d.Id" asp-route-requestId="@r.Id">Record</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
