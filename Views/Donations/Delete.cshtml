@model Donation
@{
    ViewData["Title"] = "Delete Donation";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h1 class="h4 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete this donation record?</h1>
                <dl class="row">
                    <dt class="col-4">Donor</dt><dd class="col-8">@Model.Donor.FullName (@Model.Donor.BloodGroup)</dd>
                    <dt class="col-4">Date</dt><dd class="col-8">@(Model.DonatedOn?.ToString("dd MMM yyyy"))</dd>
                    <dt class="col-4">Units</dt><dd class="col-8">@Model.Units</dd>
                    <dt class="col-4">Request</dt><dd class="col-8">@(Model.BloodRequest?.PatientName ?? "General donation")</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Yes, delete</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
