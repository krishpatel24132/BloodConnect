@model List<Donation>
@{
    ViewData["Title"] = "Donations";
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-heart-pulse text-danger"></i> Donations</h1>
    @if (isAdmin)
    {
        <a class="btn btn-bc" asp-action="Create"><i class="bi bi-plus-circle"></i> Record Donation</a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Donor</th>
                    <th>Group</th>
                    <th>Units</th>
                    <th class="d-none d-md-table-cell">Request</th>
                    <th class="d-none d-md-table-cell">Notes</th>
                    @if (isAdmin) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">No donations recorded yet.</td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@(d.DonatedOn?.ToString("dd MMM yyyy"))</td>
                        <td><a asp-controller="Donors" asp-action="Details" asp-route-id="@d.DonorId" class="text-decoration-none">@d.Donor.FullName</a></td>
                        <td><span class="blood-chip">@d.Donor.BloodGroup</span></td>
                        <td>@d.Units</td>
                        <td class="d-none d-md-table-cell">
                            @if (d.BloodRequest != null)
                            {
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@d.BloodRequestId">@d.BloodRequest.PatientName</a>
                            }
                            else { <span class="text-body-secondary">General</span> }
                        </td>
                        <td class="d-none d-md-table-cell">@d.Notes</td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
